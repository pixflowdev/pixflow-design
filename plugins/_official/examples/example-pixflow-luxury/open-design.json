{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "example-pixflow-luxury",
  "title": "Pixflow Luxury",
  "version": "0.1.0",
  "description": "Premium dark Pixflow recipe using oversized uppercase type, restrained monochrome surfaces, editorial product imagery, hairline dividers, sparse CTAs, and high-end pacing.",
  "license": "Pixflow-owned",
  "author": {
    "name": "Pixflow Design"
  },
  "tags": [
    "example",
    "first-party",
    "pixflow",
    "prototype",
    "web",
    "luxury",
    "luxury-recipe",
    "design-recipe"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "prototype",
    "platform": "desktop",
    "scenario": "design-recipe",
    "surface": "web",
    "preview": {
      "type": "html",
      "entry": "./example.html"
    },
    "useCase": {
      "query": {
        "en": "Create a Pixflow Luxury web prototype using the bundled recipe."
      },
      "exampleOutputs": [
        {
          "path": "./example.html",
          "title": "Pixflow Luxury"
        }
      ]
    },
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "designSystem": {
        "primary": true
      },
      "craft": [
        "state-coverage",
        "accessibility-baseline"
      ],
      "assets": [
        "./example.html",
        "./preview.html",
        "./SKILL.md",
        "./DESIGN.md",
        "./METHOD.md",
        "./tokens.css",
        "./recipe.json",
        "./pixflow-design.json",
        "./assets/aurum-archive-chair.png",
        "./assets/aurum-hero-still-life.png",
        "./assets/aurum-ivory-vessel.png",
        "./assets/aurum-obsidian-console.png",
        "./assets/aurum-private-viewing-room.png",
        "./assets/image-manifest.json",
        "./assets/preview-desktop.png",
        "./assets/preview-mobile.png",
        "./references/accessibility.md",
        "./references/anti-patterns.md",
        "./references/checklist.md",
        "./references/components.md",
        "./references/critique.md",
        "./references/layouts.md",
        "./references/responsive.md"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
